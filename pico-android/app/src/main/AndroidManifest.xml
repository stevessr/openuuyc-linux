<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true"/>
    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
    <application android:label="OpenUUYC PICO" android:theme="@android:style/Theme.Material.NoActionBar"
                 android:usesCleartextTraffic="false" android:allowBackup="false">
        <activity android:name=".PicoActivity" android:exported="true"
                  android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD"/>
            </intent-filter>
            <meta-data android:name="pvr.app.type" android:value="vr"/>
        </activity>
    </application>
</manifest>
