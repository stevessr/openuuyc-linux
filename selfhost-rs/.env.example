# === 必填 ===
# 公网 HTTPS 源（证书由反代/Caddy 终结；直连时也必须 HTTPS）
OPENUUYC_PUBLIC_URL=https://uu.example.com
# 管理员密钥：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OPENUUYC_ADMIN_KEY=REPLACE_WITH_32PLUS_CHARS
# 至少一个 STUN/TURN
OPENUUYC_ICE_SERVERS=stun:stun.l.google.com:19302

# === TURN（受限 UDP 网络建议）===
OPENUUYC_TURN_SECRET=
OPENUUYC_TURN_USER=
OPENUUYC_TURN_PASSWORD=

# === Keycloak / OIDC 登录（可选）===
# Keycloak realm 的 issuer；realm 里建一个 client：
#   - 公开客户端（无 secret，PKCE）或机密客户端（填 SECRET）
#   - 合法重定向 URI: https://uu.example.com/enroll/*
OPENUUYC_OIDC_ISSUER=
OPENUUYC_OIDC_CLIENT_ID=selfhost
OPENUUYC_OIDC_CLIENT_SECRET=
# 1 = 禁用管理员密钥回退，审批必须走 Keycloak
OPENUUYC_OIDC_REQUIRE=0
