OPENUUYC_PUBLIC_URL=https://uu.example.com
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OPENUUYC_ADMIN_KEY=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
OPENUUYC_ICE_SERVERS=stun:stun.l.google.com:19302
# Optional coturn REST API shared secret; pair with a turn: URL above.
OPENUUYC_TURN_SECRET=
# Or static TURN authentication for servers without REST secrets.
OPENUUYC_TURN_USER=
OPENUUYC_TURN_PASSWORD=
